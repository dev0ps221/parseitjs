[
  {
    "type": "EOS",
    "from_tokens": ["NEWLINE","EOF"]
  },
  {
    "type": "LITERAL",
    "from_tokens": ["NUMBER", "STRING" , "BOOLEAN", "NULL"]
  },
  {
    "type": "SPECIALCHAR",
    "from_tokens": ["IS", "SPACE" , "QUOTE", "DOUBLEQUOTE"]
  },
  {
    "type": "IDENTIFIER",
    "token": "identifier"
  },
  {
    "type": "GROUP",
    "start": "(",
    "end": ")",
    "inner": "EXPRESSION"
  },
  {
    "type": "BINARY_EXPRESSION",
    "operators": ["+", "-", "*", "/", "==", "!=", ">", "<", ">=", "<="],
    "associativity": "left"
  },
  {
    "type": "ASSIGNMENT_EXPRESSION",
    "args": {
      "start": "let",
      "end": ["NEWLINE","SEMICOLON","EOF"],
      "delimiter": ",",
      "operators": ["=", ":=", "+=", "-="]
    }
  },

  {
    "type": "CALL_EXPRESSION",
    "args": {
      "start": "(",
      "end": ")",
      "delimiter": ","
    }
  }
]